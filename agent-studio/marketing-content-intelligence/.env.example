# Reference template only.
# In Cloudera AI / CML, runtime environment variables should be injected from the
# session or application configuration.
# Use a local `.env` file only as an optional development fallback.

APP_NAME=Content Intelligence API
APP_ENV=dev
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

WORKFLOW_BASE_URL=https://your-deployed-workflow-base-url.cloudera.site
WORKFLOW_API_KEY=replace-with-your-api-key

REQUEST_TIMEOUT_SECONDS=120
POLLING_INTERVAL_SECONDS=3
MAX_POLLING_ATTEMPTS=40

GUARDRAILS_ENABLED=false
GUARDRAILS_HUB_TOKEN=
GUARDRAILS_TOXIC_LANGUAGE_ENABLED=true
GUARDRAILS_TOXIC_LANGUAGE_THRESHOLD=0.5
GUARDRAILS_PII_ENABLED=true
GUARDRAILS_PII_ENTITIES=EMAIL_ADDRESS,PHONE_NUMBER,PERSON
